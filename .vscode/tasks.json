{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "watch",
            "dependsOn": [
                "npm: watch:esbuild",
                "npm: watch:tsc",
                "npm: watch:vue-tsc",
                "npm: watch:vite"
            ],
            "dependsOrder": "parallel",
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "watch:esbuild",
            "group": "build",
            "problemMatcher": "$esbuild-watch",
            "isBackground": true,
            "label": "npm: watch:esbuild",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "npm",
            "script": "watch:vite",
            "group": "build",
            // A background task with no matcher never reports itself ready, so F5 would wait
            // for `vite build --watch` to exit. `background` matches vite's own watch output.
            // `pattern` is required by the schema but deliberately matches nothing: vite only
            // bundles here, and type errors belong to `watch:tsc`.
            "problemMatcher": {
                "owner": "vite",
                "source": "vite",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(?!)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*build started",
                    "endsPattern": "^\\s*built in \\d"
                }
            },
            "isBackground": true,
            "label": "npm: watch:vite",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "npm",
            "script": "watch:tsc",
            "group": "build",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "npm: watch:tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "type": "npm",
            "script": "watch:vue-tsc",
            "group": "build",
            // `watch:tsc` covers the host and src/shared, and `tsc` cannot check .vue files.
            // `vue-tsc` prints tsc's own watch messages verbatim, so `$tsc-watch` reads them.
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "label": "npm: watch:vue-tsc",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        }
    ]
}
