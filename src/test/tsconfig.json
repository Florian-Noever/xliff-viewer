{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // Vitest runs these as ESM, so `import.meta` is legal here even though the
        // host tsconfig targets CommonJS for the esbuild bundles.
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node",
            "vscode"
        ],
        // The perf project times the webview's own pure search and flatten code, which
        // addresses src/shared through the alias the webview build gives it.
        "paths": {
            "@shared/*": [
                "../shared/*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "webview",
        "integration"
    ]
}
