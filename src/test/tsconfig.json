{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // Vitest runs these as ESM, so `import.meta` is legal here even though the
        // host tsconfig targets CommonJS for the esbuild bundles.
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node",
            "vscode",
            "mocha"
        ],
        // The perf project measures the webview's own pure search and flatten code
        // (§11.5's keystroke budget), and that code addresses src/shared through the
        // alias the webview build gives it.
        "paths": {
            "@shared/*": [
                "../shared/*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "webview"
    ]
}
