{
    "name": "xliff-viewer",
    "displayName": "XLIFF Viewer",
    "description": "View and edit XLIFF translation files with a structured GUI",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.134.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "XLIFF",
        "xlf",
        "AL",
        "Business Central",
        "Dynamics 365",
        "translation",
        "localization"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "browser": "./out/web/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "xliff-viewer.helloWorld",
                "title": "Hello World"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "bun run compile",
        "compile": "bun run check-types && bun run lint && node esbuild.mjs && bun run build:webview",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.mjs --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "watch:vite": "vite build --watch",
        "build:webview": "vite build",
        "dev:webview": "vite",
        "check-types": "tsc --noEmit && vue-tsc --noEmit -p src/webview/tsconfig.json",
        "lint": "eslint src",
        "package": "vsce package",
        "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
    },
    "devDependencies": {
        "@tanstack/vue-virtual": "^3.13.24",
        "@types/mocha": "^10.0.10",
        "@types/vscode": "^1.134.0",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/test-web": "^0.0.81",
        "@vscode/vsce": "^3.6.0",
        "@vue/tsconfig": "^0.9.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.5.0",
        "eslint-plugin-vue": "^10.8.0",
        "mocha": "^11.7.6",
        "npm-run-all": "^4.1.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^7.3.1",
        "vue": "^3.5.29",
        "vue-tsc": "^3.3.11"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
